rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ESP32 device status document (read by app, written/patched by ESP32 firmware)
    match /esp32/status {
      allow read: if true;
      allow write: if true;
    }

    // ESP32 calibration document
    match /esp32/calibration {
      allow read, write: if true;
    }

    // Posture readings collection
    match /posture_data/{document} {
      allow read, write: if true;
    }

    // Calibration captures
    match /calibration_captures/{document} {
      allow read, write: if true;
    }

    // User-specific data (baseline calibration, settings, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

